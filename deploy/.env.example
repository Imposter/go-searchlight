# Settings for compose.postgres.yml and compose.sqlite.yml. Copy this file to .env beside
# them, where Compose reads it, and edit it; each value here is also the default a
# missing .env falls back to. Nothing secret belongs here: the Postgres sample generates
# its secrets into a volume, and the SQLite sample reads its API tokens from ./tokens.

# The Compose project, which prefixes the containers and volumes. The samples name
# themselves "searchlight" (Postgres) and "searchlight-sqlite" (SQLite).
# COMPOSE_PROJECT_NAME=searchlight

# The image tag, ghcr.io/imposter/searchlight:<SEARCHLIGHT_VERSION>: a release (1.7.0),
# or a moving tag (1.0, 1, latest). Upgrade by changing it and running "up -d" again,
# after reading the release's notes.
SEARCHLIGHT_VERSION=1.7.0

# The host address the API is published on: 127.0.0.1 keeps it on this host; 0.0.0.0
# serves every interface (put TLS in front first). The admin ports stay on 127.0.0.1.
SEARCHLIGHT_BIND=127.0.0.1
# compose.postgres.yml: nginx's port, the API of all three nodes.
SEARCHLIGHT_HTTP_PORT=8080
# compose.sqlite.yml: the node's API and admin ports.
SEARCHLIGHT_API_PORT=8780
SEARCHLIGHT_ADMIN_PORT=8781

# compose.postgres.yml: Postgres. The store_url is generated from the user and database
# on the first start, so change them before that, or with fresh volumes.
POSTGRES_USER=searchlight
POSTGRES_DB=searchlight
# Each node holds up to 64 connections plus one for LISTEN: keep room for every node.
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=256MB

# Node settings (docs/operations.md#every-setting).
# debug, info, warn or error.
SEARCHLIGHT_LOG_LEVEL=info
# The oldest a change may grow before it is pruned, whatever copy still needs it.
SEARCHLIGHT_CHANGELOG_RETENTION=24h
# How long the changelog is kept for a cleanly stopped node, so a node restarted within
# it replays the tail rather than rebuilding its copies.
SEARCHLIGHT_RETIRING_RETENTION=15m
# How often each shard's segments are uploaded to the database as a recovery bundle
# (0s: never), and how many bundles of each shard are kept. Worth turning on for a
# single node with a large index (docs/operations.md#recovery-bundles).
SEARCHLIGHT_BUNDLE_INTERVAL=0s
SEARCHLIGHT_BUNDLE_RETENTION=2
